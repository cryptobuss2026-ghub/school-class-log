# Copy to  .streamlit/secrets.toml  (local)  OR paste into
# Streamlit Cloud -> App -> Settings -> Secrets.
# NEVER commit the real file to GitHub.

[app]
timezone = "Asia/Karachi"
subjects = ["English", "Urdu", "Mathematics", "Science", "Social Studies", "Islamiyat", "Computer Science"]

[admin]
password = "123"

[sheets]
# Central register spreadsheet (create an empty Google Sheet and paste its ID)
teachers_register_id = "PASTE_TEACHERS_REGISTER_SHEET_ID"

# Grade/Section -> Google Sheet ID  (one spreadsheet per section)
# ID = the long string in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
[section_sheets]
"Grade 1 - Sec A" = "https://docs.google.com/spreadsheets/d/1Kn4Q8qG7EcnPlM_ORngKUxhSbul5oMY27vkX_VmodJM/edit?gid=0#gid=0"
"Grade 1 - Sec B" = "https://docs.google.com/spreadsheets/d/1XScYslzo-4XABVf-hHYhjthECC41pmpqQiA6IUIpaNk/edit?gid=0#gid=0"
"Grade 2 - Sec A" = "PASTE_SHEET_ID"
"Grade 2 - Sec B" = "PASTE_SHEET_ID"

# Copy these values from the downloaded service-account JSON key.
# Keep private_key on ONE line with literal \n characters.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa-name@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa-name%40your-project-id.iam.gserviceaccount.com"
